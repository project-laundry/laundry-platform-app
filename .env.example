# ─────────────────────────────────────────────────────────────
# NooraCare environment variables
#
# Copy to .env.local for local dev:   cp .env.example .env.local
# Staging/Production values are set per-environment in the Vercel
# dashboard (not in this file). See ENVIRONMENTS.md for the full
# per-environment matrix and setup checklist.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Use the LOCAL/STAGING project for dev — never point .env.local at production.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── App ───────────────────────────────────────────────────────
# Must match the deployment's public origin. Used to build Vipps
# return URLs in src/lib/payments/vipps/service.ts.
#   local:      http://localhost:3000
#   staging:    https://test.nooracare.no
#   production: https://nooracare.no
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Vipps ─────────────────────────────────────────────────────
# Test creds + apitest.vipps.no for local/staging.
# Production uses live creds + https://api.vipps.no.
VIPPS_CLIENT_ID=your_client_id
VIPPS_CLIENT_SECRET=your_client_secret
VIPPS_SUBSCRIPTION_KEY=your_subscription_key
VIPPS_MERCHANT_SERIAL_NUMBER=your_msn
# REQUIRED, no default. Exactly https://apitest.vipps.no or https://api.vipps.no;
# every Vipps call throws when it is missing or anything else (fail closed).
VIPPS_API_URL=https://apitest.vipps.no

# Webhook HMAC-SHA256 secret. The per-endpoint secret takes precedence;
# you may instead set a single shared VIPPS_WEBHOOK_SECRET.
VIPPS_WEBHOOK_SECRET_RECURRING=your_recurring_webhook_secret

# Shows the "Auto-godkjenn avtale" checkbox on the order confirm step and
# enables forceAcceptAgreementAction (Vipps test-only endpoint). Must be the
# literal string "true"; only honoured together with the test VIPPS_API_URL.
# Set in local dev and in Vercel Preview (develop). NEVER set in Production.
NEXT_PUBLIC_VIPPS_ALLOW_FORCE_ACCEPT=true

# ── Anthropic (Claude) ────────────────────────────────────────
# Used only by the cleaner onboarding equipment step to suggest washing
# machine details from a photo (src/lib/ai/machine-recognition.ts).
# Optional: when unset, the photo button reports "not available" and the
# cleaner fills the fields manually.
ANTHROPIC_API_KEY=sk-ant-your_key

# ── Admin digest (Vercel cron → /api/cron/admin-digest) ───────
# Vercel sends `Authorization: Bearer $CRON_SECRET` with every cron call;
# the route answers 401 without it. Any long random string. Only Production
# runs crons, but set it on staging too so the route can be curl-tested there.
CRON_SECRET=
# Resend API key (https://resend.com → API Keys). The digest is sent with
# fetch() against POST https://api.resend.com/emails — no SDK. The sender
# domain must be verified in Resend (see ENVIRONMENTS.md launch checklist).
RESEND_API_KEY=
# Optional sender; defaults to "NooraCare <varsel@nooracare.no>".
# ADMIN_DIGEST_FROM=
